# Frontend environment template. Copy to .env.local for local overrides.
# Only VITE_-prefixed variables reach the browser bundle, which is exactly why
# no AI provider key belongs in this file. The backend holds that key.

# Base URL the app calls. Leave as /api to use the Vite dev proxy locally and a
# reverse proxy in production. Set to a full URL when the API lives elsewhere,
# e.g. https://resumeiq-api.onrender.com/api
VITE_API_BASE_URL=/api

# Where the dev proxy forwards /api requests during `npm run dev`
VITE_API_PROXY_TARGET=http://localhost:8080
