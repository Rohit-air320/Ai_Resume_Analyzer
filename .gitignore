# ---------- Java / Maven ----------
target/
!.mvn/wrapper/maven-wrapper.jar
*.jar
*.war
*.class
hs_err_pid*
replay_pid*

# ---------- Node / Vite ----------
node_modules/
dist/
dist-ssr/
.vite/
coverage/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Environment & secrets ----------
.env
.env.local
.env.*.local
!.env.example
*.pem
*.key

# ---------- Uploaded user data (never commit resumes) ----------
backend/storage/
storage/
uploads/
# Where the test suite writes its generated PDFs and DOCX files. `mvn clean` removes
# it; this is the safety net for a run that failed before its own cleanup.
build/

# ---------- Python (the verification harness) ----------
# `tools/verify_sources.py` is imported by the mutation drill, which makes CPython
# write bytecode next to it. Generated, machine-specific, and never worth a diff.
__pycache__/
*.py[cod]

# ---------- IDE / OS ----------
.idea/
*.iml
*.ipr
*.iws
.vscode/
!.vscode/extensions.json
.settings/
.classpath
.project
.DS_Store
Thumbs.db

# ---------- Logs ----------
logs/
*.log
