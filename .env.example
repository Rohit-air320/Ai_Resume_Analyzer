# ResumeIQ — environment template
# Copy to .env and fill in real values. Never commit .env.
#
#   cp .env.example .env
#
# The backend reads these via Spring's environment resolution, so you can either
# export them in your shell, set them in your IDE run configuration, or let
# docker-compose pass them through (Phase 13).

# ---------------------------------------------------------------------------
# Active profile: "dev" (H2 in-memory, zero setup) or "mysql" (real MySQL 8)
# ---------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# ---------------------------------------------------------------------------
# Database — only needed when SPRING_PROFILES_ACTIVE=mysql
# ---------------------------------------------------------------------------
DB_URL=jdbc:mysql://localhost:3306/resumeiq?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=resumeiq
DB_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Authentication (Phase 3)
#
# Two tokens, on purpose. The access token is short-lived and lives only in
# browser memory, so a leaked one is worth minutes. The refresh token is a
# random value in an httpOnly cookie, rotated on every use — JavaScript cannot
# read it, and presenting an already-spent one ends the whole session.
# ---------------------------------------------------------------------------

# HMAC key for access tokens, at least 32 characters. Generate one with:
#   openssl rand -base64 48
# Leave this blank in dev and the API mints a random key at startup, which
# means tokens stop working after a restart. Any other profile refuses to
# start without it — a shipped default secret is the same as no secret.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Access-token lifetime, in minutes. Short by design: the frontend refreshes
# silently before it expires, so raising this only widens the window in which
# a stolen token still works.
ACCESS_TOKEN_MINUTES=15

# Refresh-token lifetime, in days. Because every use rotates the token, this
# is how long you can be *inactive* before signing in again, not how long any
# single token survives.
REFRESH_TOKEN_DAYS=7

# BCrypt cost. Each step doubles the work: 12 is roughly a quarter of a second
# per hash, which is the point. Do not lower it outside the test suite.
BCRYPT_STRENGTH=12

# Refresh-cookie attributes. SameSite=Lax is what makes /api/auth/refresh safe
# without a CSRF token, because a cross-site POST carries no cookie at all.
# Serving the frontend from a different site means SameSite=None — and then you
# need a real CSRF token, so treat that as a decision rather than a tweak.
REFRESH_COOKIE_NAME=resumeiq_rt
REFRESH_COOKIE_SAME_SITE=Lax

# Must be true anywhere with HTTPS. False only for local http://localhost,
# which is not a secure context, so the browser would drop the cookie.
REFRESH_COOKIE_SECURE=false

# Failed sign-ins allowed per email before a lockout window starts. The
# per-address budget is four times this, because an office or a campus can put
# many legitimate people behind one address.
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# "none" reports the socket that actually connected. Set this to "framework"
# only behind a proxy that sets X-Forwarded-* and strips whatever the client
# sent — otherwise a caller can forge the address the login throttle counts
# against and walk straight past the lockout.
FORWARD_HEADERS_STRATEGY=none

# ---------------------------------------------------------------------------
# AI provider (Phase 6). The key is read by the backend only and is never
# sent to the browser. Set AI_PROVIDER=mock to run without a key.
# ---------------------------------------------------------------------------
AI_PROVIDER=mock
AI_API_KEY=
AI_BASE_URL=https://api.anthropic.com
AI_MODEL=claude-sonnet-4-20250514
AI_TIMEOUT_SECONDS=90
AI_MAX_OUTPUT_TOKENS=8000

# ---------------------------------------------------------------------------
# Uploads (Phase 4)
# ---------------------------------------------------------------------------
MAX_UPLOAD_SIZE=5MB
MAX_REQUEST_SIZE=8MB
RESUME_STORAGE_DIR=./storage/resumes

# ---------------------------------------------------------------------------
# CORS — comma-separated list of allowed browser origins
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
